# Copy to .env (git-ignored) for running the bot on your own computer.
# On a host (Render etc.) set these as environment variables instead.
BOT_TOKEN=PUT_YOUR_BOTFATHER_TOKEN_HERE
# Optional: free Postgres so users survive redeploys (Supabase "Session pooler" URI)
DATABASE_URL=
# Default language for new users: en or ar
LANG=en
